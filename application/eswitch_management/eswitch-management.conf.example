# DPDK EAL arguments. Reserve a dedicated Arm core for the manager loop.
EAL_ARGS="-l 0"

# BlueField Arm-side PCI address of the parent network device.
DEVICE_PCI="03:00.0"

# Persistent desired state. systemd creates the parent directory through
# StateDirectory=eswitch-management before starting the daemon.
ESWITCH_STATE_FILE="/var/lib/eswitch-management/eswitch.conf"

# VF indexes, not DPDK port IDs. Limit this integration test to VF 7-15.
ESWITCH_VF_SCOPE="7-15"

# Opt-in private-to-private IPv4 hardware LPM. Keep disabled until the BF3
# smoke test confirms pipe creation, counters, TTL and exception fallback.
ESWITCH_HW_ROUTING="0"

# Maximum private hardware routes requested from the HWS LPM table. It must be
# a power of two from 64 through 1024. The application reserves matching
# actions memory before starting Flow ports and may admit a smaller table if
# the device cannot allocate the requested LPM size.
ESWITCH_HW_ROUTE_CAPACITY="1024"

# Rate-limit broadcast ARP from router uplinks in DOCA Flow before RSS/Arm.
# Unicast ARP replies and non-broadcast traffic bypass this meter. Set PPS to
# 0 to disable the classifier and use exact Arm filtering only.
ESWITCH_UPLINK_ARP_PPS="256"
ESWITCH_UPLINK_ARP_BURST="64"

# Successful slow-path packet traces are expensive at scale. Errors and
# counters remain active when this is disabled.
ESWITCH_PACKET_DEBUG="0"
