#!/usr/bin/env python3
# Apache-2.0. Offline control-protocol executable; no production socket access.
import os
from pathlib import Path
import sys
from dpu_eswitch import Error
from mock_control import Mock
try:
    state = Path(os.environ["MOCK_STATE"])
    state.mkdir(parents=True, exist_ok=True)
    print(Mock(state / "state.json").run(" ".join(sys.argv[1:])), end="")
except (Error, KeyError, ValueError) as exc:
    print(f"ERR {exc}")
    sys.exit(1)
